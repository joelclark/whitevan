{
  "permissions": {
    "allow": [
      "Bash(composer run ci:check:*)",
      "Bash(composer run test:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan make:command:*)",
      "Bash(php artisan make:controller:*)",
      "Bash(php artisan make:migration:*)",
      "Bash(php artisan make:request:*)",
      "Bash(php artisan make:test:*)",
      "Bash(php artisan migrate:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan test:*)",
      "Bash(php:*)",
      "Bash(sed:*)",
      "Bash(sort -t: -k2 -nr)",
      "Bash(vendor/bin/pint:*)",
      "Bash(wc:*)",
      "Bash(xargs cat:*)",
      "Bash(xargs ls:*)",
      "mcp__laravel-boost__application-info",
      "mcp__laravel-boost__browser-logs",
      "mcp__laravel-boost__database-query",
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__get-absolute-url",
      "mcp__laravel-boost__get-config",
      "mcp__laravel-boost__last-error",
      "mcp__laravel-boost__list-routes",
      "mcp__laravel-boost__read-log-entries",
      "mcp__laravel-boost__search-docs",
      "mcp__laravel-boost__tinker",
      "Bash(npx prettier:*)",
      "WebFetch(domain:nightwatch.laravel.com)",
      "WebSearch"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ],
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
