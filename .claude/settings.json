      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc:*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan make:command:*)",
      "Bash(php artisan make:controller:*)",
